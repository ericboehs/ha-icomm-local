# icomm_local relay -- systemd unit. Install to /etc/systemd/system/ and edit
# the paths and ports for your host. See README.md for the full procedure,
# including steering the water heater's traffic to this host.
[Unit]
Description=iCOMM local relay for A.O. Smith water heaters
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=icomm
WorkingDirectory=/opt/icomm-local/relay
Environment=LISTEN_PORT=443
Environment=STATE_PORT=8124
Environment=UPSTREAM=proxy-ingress-usfield.aylanetworks.com
ExecStart=/opt/icomm-local/relay/.venv/bin/python icomm_relay.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
